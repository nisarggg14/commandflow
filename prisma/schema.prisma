generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ApplicationStatus {
  CONNECTED
  DISCONNECTED
}

enum ActivityStatus {
  SUCCESS
  FAILED
  PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  EXECUTED
  EXECUTING
  FAILED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  industry    String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  applications     Application[]
  connectedClients ConnectedClient[]
  conversations    Conversation[]
  activityLogs     ActivityLog[]
  approvals        Approval[]
  automations      Automation[]
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole
  active   Boolean @default(true)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  sessions      Session[]
  conversations Conversation[]
  activityLogs  ActivityLog[]
  mfaChallenges MfaChallenge[]
  approvalsRequested Approval[] @relation("ApprovalRequester")
  approvalsReviewed  Approval[] @relation("ApprovalApprover")
  automationsOwned Automation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())

  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model RateLimitBucket {
  id String @id
  key String @unique
  count Int
  windowStart DateTime
  expiresAt DateTime
  @@index([expiresAt])
}

model Conversation {
  id String @id @default(cuid())

  title String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  connectedClientId String?
  connectedClient   ConnectedClient? @relation(fields: [connectedClientId], references: [id], onDelete: SetNull)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([connectedClientId])
}

model Message {
  id String @id @default(cuid())

  role MessageRole

  content String @db.Text

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

}

model Automation {
  id                String   @id @default(cuid())
  name              String
  toolName          String
  argumentsJson     String   @db.Text
  schedule          String
  enabled           Boolean  @default(true)
  lastExecutionKey  String?

  lastExecutionStatus String?
  lastRunAt         DateTime?
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connectedClientId String
  connectedClient   ConnectedClient @relation(fields: [connectedClientId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, enabled])
  @@index([connectedClientId])
}

model ConnectedClient {
  id          String       @id @default(cuid())

  name        String
  slug        String
  description String?
  status      ClientStatus @default(ACTIVE)
  baseUrl     String
  authType    String       @default("BEARER")
  authConfig  String?      @db.Text
  enabledTools String?     @db.Text

  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  activityLogs ActivityLog[]
  automations Automation[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
  @@index([slug])
}

model Application {
  id String @id @default(cuid())

  name        String
  description String?
  baseUrl     String

  status ApplicationStatus @default(CONNECTED)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id String @id @default(cuid())

  action String

  status ActivityStatus

  details String? @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  connectedClientId String?
  connectedClient   ConnectedClient? @relation(fields: [connectedClientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([connectedClientId])
}

model MfaChallenge {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose       String
  riskLevel     String?
  challengeToken String @unique
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
}

model Approval {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  approverId String?
  approver   User?  @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  toolName            String
  riskLevel           String
  purpose             String
  argumentsHash       String
  safeArgumentsSummary String @db.Text
  status              ApprovalStatus @default(PENDING)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?
  executedAt          DateTime?

  @@index([companyId])
  @@index([requesterId])
  @@index([approverId])
  @@index([status])
  @@index([expiresAt])
}
